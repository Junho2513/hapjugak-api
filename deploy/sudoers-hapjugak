# /etc/sudoers.d/hapjugak-deploy   (권한 0440)
#
# deploy.sh 는 webhook 데몬이 ubuntu 로 실행합니다.
# 배포 마지막에 nginx 설정을 확인하고 reload 해야 하는데 그건 root 의 일입니다.
#
# 비밀번호 없이 열어주되, 열어주는 것은 이 두 가지뿐입니다.
# 셸이나 편집기를 열어주면 그 길로 무엇이든 할 수 있게 되므로 적지 않습니다.
#
# (ubuntu 는 이미 docker 그룹에 있어 사실상 root 와 같은 일을 할 수 있습니다.
#  그래서 이 두 줄이 새로 여는 권한은 사실상 없습니다. 그래도 좁게 적는 이유는,
#  나중에 docker 그룹을 거두더라도 이 파일이 조용히 구멍으로 남지 않게 하기 위해서입니다.)
ubuntu ALL=(root) NOPASSWD: /usr/sbin/nginx -t
ubuntu ALL=(root) NOPASSWD: /usr/bin/systemctl reload nginx
