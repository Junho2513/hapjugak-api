###############################################
# 1. 인증
###############################################

### 1-1. 회원가입
POST http://localhost:8080/members
Content-Type: application/json

{
  "email": "wnsgh409@gmail.com",
  "password": "test1234",
  "nickname": "준호",
  "area": "서울",
  "bio": "기타 칩니다"
}

### 1-2. 회원가입 — 두 번째 사람 (권한 테스트용)
POST http://localhost:8080/members
Content-Type: application/json

{
  "email": "drummer@example.com",
  "password": "test1234",
  "nickname": "드러머",
  "area": "경기",
  "bio": "드럼 20년"
}

### 1-3. 이메일 중복 (409 기대)
POST http://localhost:8080/members
Content-Type: application/json

{
  "email": "wnsgh409@gmail.com",
  "password": "test1234",
  "nickname": "가짜",
  "area": "부산",
  "bio": ""
}

### 1-4. 로그인 → 토큰 자동 저장
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "wnsgh409@gmail.com",
  "password": "test1234"
}

> {%
    client.global.set("token", response.body.accessToken);
    client.global.set("myId", response.body.memberId);
%}

### 1-5. 두 번째 사람 로그인 → token2 저장
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "drummer@example.com",
  "password": "test1234"
}

> {%
    client.global.set("token2", response.body.accessToken);
%}

### 1-6. 비밀번호 틀림 (401 기대)
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "wnsgh409@gmail.com",
  "password": "틀린비밀번호"
}


###############################################
# 2. 회원
###############################################

### 2-1. 내 정보 (200)
GET http://localhost:8080/members/me
Authorization: Bearer {{token}}

### 2-2. 내 정보 — 토큰 없이 (401 기대)
GET http://localhost:8080/members/me

### 2-3. 회원 목록 — 일반 사용자 (403 기대)
GET http://localhost:8080/members
Authorization: Bearer {{token}}

### 2-4. 내 정보 수정
PUT http://localhost:8080/members/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "무시됨",
  "password": "무시됨",
  "nickname": "준호",
  "area": "경기",
  "bio": "기타랑 베이스 칩니다"
}


###############################################
# 3. 합주 일정
###############################################

### 3-1. 일정 만들기 (마감 안 지남) → eventId 저장
POST http://localhost:8080/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "12월 수원 J-POP 합주벙",
  "date": "2026-12-25",
  "deadline": "2026-12-20",
  "place": "수원 라이브하우스"
}

> {%
    client.global.set("eventId", response.body.id);
%}

### 3-2. 마감 지난 일정 만들기 → closedEventId 저장
POST http://localhost:8080/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "이미 마감된 합주",
  "date": "2026-11-01",
  "deadline": "2026-10-01",
  "place": "서울"
}

> {%
    client.global.set("closedEventId", response.body.id);
%}

### 3-3. 일정 만들기 — 토큰 없이 (401 기대)
POST http://localhost:8080/events
Content-Type: application/json

{
  "title": "몰래 만드는 일정",
  "date": "2026-12-25",
  "deadline": "2026-12-20",
  "place": "어딘가"
}

### 3-4. 일정 전체 조회 (토큰 불필요)
GET http://localhost:8080/events

### 3-5. 일정 하나 조회
GET http://localhost:8080/events/{{eventId}}


###############################################
# 4. 곡
###############################################

### 4-1. 곡 후보 등록 → songId, slotId 저장
POST http://localhost:8080/songs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "廻廻奇譚",
  "artist": "Eve",
  "youtubeUrl": "https://youtu.be/gsq4lF9ONKQ",
  "description": "주술회전 1기 오프닝",
  "parts": ["VOCAL", "GUITAR1", "BASS", "DRUM", "KEY1"]
}

> {%
    client.global.set("songId", response.body.id);
    client.global.set("slotId", response.body.slots[0].id);
%}

### 4-2. 곡 등록 — 토큰 없이 (401 기대)
POST http://localhost:8080/songs
Content-Type: application/json

{
  "title": "몰래 올리는 곡",
  "artist": "해커",
  "parts": ["VOCAL"]
}

### 4-3. 곡 후보 목록 (토큰 불필요)
GET http://localhost:8080/songs/candidates

### 4-4. 곡 하나 조회
GET http://localhost:8080/songs/{{songId}}


###############################################
# 5. 파트 참여 — 핵심
###############################################

### 5-1. 보컬 자리 잡기 (200)
POST http://localhost:8080/songs/{{songId}}/slots/{{slotId}}/claim
Authorization: Bearer {{token}}

### 5-2. 같은 자리에 다른 사람 (409 기대)
POST http://localhost:8080/songs/{{songId}}/slots/{{slotId}}/claim
Authorization: Bearer {{token2}}

### 5-3. 남의 자리 빼기 (403 기대)
DELETE http://localhost:8080/songs/{{songId}}/slots/{{slotId}}/claim
Authorization: Bearer {{token2}}

### 5-4. 자리 잡기 — 토큰 없이 (401 기대)
POST http://localhost:8080/songs/{{songId}}/slots/{{slotId}}/claim

### 5-5. 본인 자리 빼기 (200)
DELETE http://localhost:8080/songs/{{songId}}/slots/{{slotId}}/claim
Authorization: Bearer {{token}}


###############################################
# 6. 곡 ↔ 일정 배정
###############################################

### 6-1. 곡을 일정으로 보내기 (200)
PATCH http://localhost:8080/songs/{{songId}}/event/{{eventId}}
Authorization: Bearer {{token}}

### 6-2. 일정에 배정된 곡 보기
GET http://localhost:8080/songs?eventId={{eventId}}

### 6-3. 마감 지난 일정으로 보내기 (409 기대)
PATCH http://localhost:8080/songs/{{songId}}/event/{{closedEventId}}
Authorization: Bearer {{token}}

### 6-4. 곡 후보로 되돌리기 (200)
PATCH http://localhost:8080/songs/{{songId}}/event
Authorization: Bearer {{token}}

### 6-5. 합주 완료 처리
PATCH http://localhost:8080/events/{{eventId}}/complete
Authorization: Bearer {{token}}

### 6-6. 완료된 일정만 (= 추억 저장소)
GET http://localhost:8080/events/completed