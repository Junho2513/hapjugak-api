###############################################
#  합주각 API 테스트
#
#  사용법: 1번 섹션부터 순서대로 ▶ 실행
#  토큰과 id는 자동 저장됩니다 ({{token}}, {{songId}} ...)
#  토큰 만료(2시간) 시 1-3 로그인만 다시 실행
###############################################

@host = http://localhost:8080


###############################################
#  1. 인증
###############################################

### 1-1. 회원가입
POST {{host}}/members
Content-Type: application/json

{
  "email": "guitarist@example.com",
  "password": "test1234",
  "nickname": "기타리스트",
  "area": "서울",
  "bio": "일렉기타 칩니다"
}

### 1-2. 회원가입 — 두 번째 사람 (권한 테스트용)
POST {{host}}/members
Content-Type: application/json

{
  "email": "drummer@example.com",
  "password": "test1234",
  "nickname": "드러머",
  "area": "경기",
  "bio": "드럼 20년"
}

### 1-3. 로그인 → token 자동 저장
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "guitarist@example.com",
  "password": "test1234"
}

> {%
    client.global.set("token", response.body.accessToken);
    client.global.set("myId", response.body.memberId);
%}

### 1-4. 두 번째 사람 로그인 → token2 자동 저장
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "drummer@example.com",
  "password": "test1234"
}

> {%
    client.global.set("token2", response.body.accessToken);
%}

### 1-5. [실패] 이메일 중복 → 409
POST {{host}}/members
Content-Type: application/json

{
  "email": "guitarist@example.com",
  "password": "test1234",
  "nickname": "가짜",
  "area": "부산",
  "bio": ""
}

### 1-6. [실패] 비밀번호 틀림 → 401
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "guitarist@example.com",
  "password": "wrong-password"
}

### 1-7. [실패] 없는 계정 → 401 (같은 메시지여야 함: 계정 열거 방지)
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "test1234"
}

### 1-8. [실패] 구글 로그인 — 위조 토큰 → 401
POST {{host}}/auth/google
Content-Type: application/json

{
  "idToken": "this.is.not.a.real.token"
}


###############################################
#  2. 회원
###############################################

### 2-1. 내 정보
GET {{host}}/members/me
Authorization: Bearer {{token}}

### 2-2. 특정 회원 프로필 (공개)
GET {{host}}/members/{{myId}}

### 2-3. 내 정보 수정 (email·password는 무시되어야 함)
PUT {{host}}/members/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "hacker@example.com",
  "password": "hacked",
  "nickname": "기타리스트",
  "area": "경기",
  "bio": "일렉기타와 베이스를 칩니다"
}

### 2-4. [실패] 내 정보 — 토큰 없이 → 401
GET {{host}}/members/me

### 2-5. [실패] 회원 목록 — 일반 사용자 → 403
GET {{host}}/members
Authorization: Bearer {{token}}


###############################################
#  3. 합주 일정
###############################################

### 3-1. 일정 만들기 (마감 전) → eventId 저장
POST {{host}}/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "12월 수원 J-POP 합주벙",
  "date": "2026-12-25",
  "deadline": "2026-12-20",
  "place": "수원 라이브하우스"
}

> {%
    client.global.set("eventId", response.body.id);
%}

### 3-2. 일정 만들기 (마감 지남) → closedEventId 저장
POST {{host}}/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "이미 마감된 합주",
  "date": "2026-11-01",
  "deadline": "2026-10-01",
  "place": "서울"
}

> {%
    client.global.set("closedEventId", response.body.id);
%}

### 3-3. 일정 전체 조회 (공개)
GET {{host}}/events

### 3-4. 일정 하나 조회
GET {{host}}/events/{{eventId}}

### 3-5. [실패] 일정 만들기 — 토큰 없이 → 401
POST {{host}}/events
Content-Type: application/json

{
  "title": "몰래 만드는 일정",
  "date": "2026-12-25",
  "deadline": "2026-12-20",
  "place": "어딘가"
}


###############################################
#  4. 곡
###############################################

### 4-1. 곡 후보 등록 → songId, slotId 저장
#       proposerId를 안 보내는데 proposerNickname이 채워져야 함
POST {{host}}/songs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "廻廻奇譚",
  "artist": "Eve",
  "youtubeUrl": "https://youtu.be/gsq4lF9ONKQ",
  "description": "주술회전 1기 오프닝",
  "parts": ["VOCAL", "GUITAR1", "BASS", "DRUM", "KEY1"]
}

> {%
    client.global.set("songId", response.body.id);
    client.global.set("slotId", response.body.slots[0].id);
%}

### 4-2. 곡 하나 더 등록 (검색 테스트용)
POST {{host}}/songs
Content-Type: application/json
Authorization: Bearer {{token2}}

{
  "title": "奏",
  "artist": "스키마스위치",
  "parts": ["VOCAL", "ACOUSTIC", "KEY1"]
}

### 4-3. 곡 후보 목록 (공개)
GET {{host}}/songs/candidates

### 4-4. 곡 하나 조회
GET {{host}}/songs/{{songId}}

### 4-5. [실패] 곡 등록 — 토큰 없이 → 401
POST {{host}}/songs
Content-Type: application/json

{
  "title": "몰래 올리는 곡",
  "artist": "해커",
  "parts": ["VOCAL"]
}


###############################################
#  5. 파트 참여 — 핵심 기능
###############################################

### 5-1. 보컬 자리 잡기
POST {{host}}/songs/{{songId}}/slots/{{slotId}}/claim
Authorization: Bearer {{token}}

### 5-2. [실패] 같은 자리에 다른 사람 → 409
POST {{host}}/songs/{{songId}}/slots/{{slotId}}/claim
Authorization: Bearer {{token2}}

### 5-3. [실패] 남의 자리 빼기 → 403
DELETE {{host}}/songs/{{songId}}/slots/{{slotId}}/claim
Authorization: Bearer {{token2}}

### 5-4. [실패] 자리 잡기 — 토큰 없이 → 401
POST {{host}}/songs/{{songId}}/slots/{{slotId}}/claim

### 5-5. 본인 자리 빼기
DELETE {{host}}/songs/{{songId}}/slots/{{slotId}}/claim
Authorization: Bearer {{token}}


###############################################
#  6. 곡 ↔ 일정 배정
###############################################

### 6-1. 곡을 일정으로 보내기
PATCH {{host}}/songs/{{songId}}/event/{{eventId}}
Authorization: Bearer {{token}}

### 6-2. 일정에 배정된 곡 보기
GET {{host}}/songs?eventId={{eventId}}

### 6-3. [실패] 마감 지난 일정으로 보내기 → 409
PATCH {{host}}/songs/{{songId}}/event/{{closedEventId}}
Authorization: Bearer {{token}}

### 6-4. 곡 후보로 되돌리기
PATCH {{host}}/songs/{{songId}}/event
Authorization: Bearer {{token}}

### 6-5. 합주 완료 처리
PATCH {{host}}/events/{{eventId}}/complete
Authorization: Bearer {{token}}

### 6-6. 완료된 일정 (= 추억 저장소)
GET {{host}}/events/completed


###############################################
#  7. 검색 (QueryDSL 동적 쿼리)
#     콘솔의 SQL이 조건마다 달라지는 걸 확인
###############################################

### 7-1. 조건 없음 — where 절이 없어야 함
GET {{host}}/songs/search

### 7-2. 키워드 — title 또는 artist
GET {{host}}/songs/search?keyword=eve

### 7-3. 드럼 자리가 비어 있는 곡 — exists 서브쿼리
GET {{host}}/songs/search?openPart=DRUM

### 7-4. 곡 후보 중에서 보컬이 비어 있는 것
GET {{host}}/songs/search?candidateOnly=true&openPart=VOCAL

### 7-5. 특정 일정 안에서 검색
GET {{host}}/songs/search?eventId={{eventId}}

### 7-6. 조건 세 개 동시에 — and로 묶여야 함
GET {{host}}/songs/search?keyword=eve&openPart=GUITAR1&candidateOnly=true


###############################################
#  8. 정리
###############################################

### 8-1. 곡 삭제 (올린 사람만)
DELETE {{host}}/songs/{{songId}}
Authorization: Bearer {{token}}

### 8-2. 일정 삭제
DELETE {{host}}/events/{{eventId}}
Authorization: Bearer {{token}}